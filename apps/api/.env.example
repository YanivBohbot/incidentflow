# Copy this file to .env and replace CHANGE_ME values.
# Only OPENAI_API_KEY and DATABASE_URL are required. External integrations stay
# disabled until their credentials have been configured.

# Application
APP_NAME=IncidentFlow API
ENVIRONMENT=development
API_PREFIX=/api

# OpenAI
OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4.1-mini

# PostgreSQL (host-based development). Docker Compose overrides this host with
# the internal postgres service while keeping the same database credentials.
DATABASE_URL=postgresql+psycopg://incidentflow:incidentflow_dev@localhost:5432/incidentflow_db

# LangSmith tracing
LANGSMITH_TRACING=false
LANGSMITH_PROJECT="incidentflow-development"
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=CHANGE_ME

# Jira MCP. The `tools=all` endpoint is filtered by IncidentFlow to the approved tools only.
JIRA_MCP_ENABLED=false
JIRA_MCP_URL=https://mcp.atlassian.com/v2/mcp?tools=all
# Keep false until an administrator has enabled Jira MCP Write permissions and reviewed the UI/API flow.
JIRA_MCP_WRITE_ENABLED=false
# Optional: persist Jira OAuth tokens encrypted at rest between process restarts.
# Generate a local value with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
MCP_OAUTH_TOKEN_STORE_DIR=.local/oauth-tokens
MCP_OAUTH_STORAGE_ENCRYPTION_KEY=CHANGE_ME

# MongoDB MCP
MONGODB_MCP_ENABLED=false
MONGODB_MCP_URL=http://127.0.0.1:3000/mcp
MONGODB_MCP_CONNECTION_STRING=mongodb://127.0.0.1:27017/?directConnection=true
MONGODB_MCP_DATABASE=incidentflow_dev
MONGODB_MCP_EVENTS_COLLECTION=operational_events

# GitHub MCP (read-only). Comma-separated owner/repository allowlist.
GITHUB_MCP_ENABLED=false
GITHUB_MCP_TRANSPORT=stdio
GITHUB_MCP_URL=
GITHUB_MCP_REPOSITORIES=owner/repository
GITHUB_PERSONAL_ACCESS_TOKEN=CHANGE_ME

# AWS CloudWatch MCP (read-only). Uses awslabs.cloudwatch-mcp-server over stdio through uv.
# Locally, point AWS_PROFILE at a read-only role; leave it empty on AWS to use the attached IAM role.
CLOUDWATCH_MCP_ENABLED=false
CLOUDWATCH_MCP_AWS_PROFILE=
CLOUDWATCH_MCP_AWS_REGION=us-east-1
# Comma-separated log groups the agent may query with Logs Insights.
CLOUDWATCH_MCP_LOG_GROUPS=
CLOUDWATCH_MCP_TIMEOUT_SECONDS=90
CLOUDWATCH_MCP_LOOKBACK_MINUTES=60
# Optional override of the stdio launcher (comma-separated arguments).
# CLOUDWATCH_MCP_COMMAND=uv
# CLOUDWATCH_MCP_COMMAND_ARGS=tool,run,--from,awslabs.cloudwatch-mcp-server@0.3.1,awslabs.cloudwatch-mcp-server

# Pinecone is read-only at runtime. Create the index manually before the explicit ingestion step.
PINECONE_ENABLED=false
PINECONE_API_KEY=CHANGE_ME
PINECONE_INDEX_NAME=incidentflow-runbooks
PINECONE_NAMESPACE=official-public-docs
PINECONE_EMBEDDING_MODEL=text-embedding-3-small
PINECONE_TOP_K=3
PINECONE_RESOLVED_INCIDENTS_ENABLED=false
