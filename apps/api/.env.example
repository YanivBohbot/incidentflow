# Required application settings. Copy this file to .env and replace CHANGE_ME.
APP_NAME=IncidentFlow API
ENVIRONMENT=development
API_PREFIX=/api
AUTH_ENABLED=false

OPENAI_API_KEY=CHANGE_ME
OPENAI_MODEL=gpt-4.1-mini
OPENAI_TIMEOUT_SECONDS=60

# Used for host-based development. Docker Compose overrides this host with
# the internal postgres service while keeping the same database credentials.
DATABASE_URL=postgresql+psycopg://incidentflow:incidentflow_dev@127.0.0.1:5432/incidentflow_db

LANGSMITH_TRACING=false
LANGSMITH_PROJECT=incidentflow-development

# External integrations remain opt-in. Do not enable them until their
# credentials and container/network topology have been configured.
JIRA_MCP_ENABLED=false
JIRA_MCP_WRITE_ENABLED=false
MONGODB_MCP_ENABLED=false
GITHUB_MCP_ENABLED=false
PINECONE_ENABLED=false
PINECONE_RESOLVED_INCIDENTS_ENABLED=false
