# Used by Docker Compose only. Copy to .env and replace Keycloak values.
# Keep this value when reusing the existing local PostgreSQL volume. Choose a
# different password only before the first `docker compose up` for a new volume.
POSTGRES_PASSWORD=incidentflow_dev
KEYCLOAK_BOOTSTRAP_ADMIN_USERNAME=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME
WEB_PORT=5173
# Only for docker-compose.cloudwatch.yml: host directory with AWS config and credentials,
# for example C:/Users/<you>/.aws on Windows or /home/<you>/.aws on Linux.
AWS_CONFIG_DIR=
